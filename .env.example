# ============================================================
# Online Quiz Plattform - Umgebungsvariablen (BEISPIEL)
# Kopiere diese Datei nach .env und passe die Werte an.
# KEINE echten Geheimnisse in dieses Repository einchecken!
# ============================================================

# Server
NODE_ENV=development
PORT=3001

# Datenbank (SQLite für v1, PostgreSQL für skalierte Installation)
DATABASE_URL="file:./storage/database/quiz.db"

# Session-Secret für Cookie-Signierung (mind. 32 Zeichen, zufällig)
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_32CHARS_PLUS_HERE

# Erste Admin/Moderator-Konfiguration (nur für Bootstrap)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=CHANGE_ME_IN_PRODUCTION_USE_32_PLUS_CHARS

# App-URL (für Links und CORS)
PUBLIC_APP_URL=http://localhost:3001

# Erlaubte Origins (durch Komma getrennt, für Entwicklung)
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5173

# Storage (Pfad für Uploads und Backups)
STORAGE_ROOT=./storage

# Upload-Limits
MAX_UPLOAD_SIZE_MB=50
MAX_IMAGE_SIZE_MB=10
MAX_AVATAR_SIZE_MB=5

# Archivierung
ROOM_ARCHIVE_HOURS=24
CODE_REUSE_DAYS=30

# Zuschauer
DEFAULT_VIEWER_LIMIT=50

# Geo-Quiz Standardwerte
GEO_DEFAULT_TIMER_MS=20000
GEO_MIN_TIMER_MS=5000
GEO_DEFAULT_POINTS=100
GEO_DEFAULT_WRONG_POINTS=0

# Jeopardy Standardwerte
JEOPARDY_DEFAULT_TIMER_MS=20000
JEOPARDY_BUZZER_LOCKOUT_MS=1000

# Logging
LOG_LEVEL=info

# Backup
BACKUP_RETENTION_DAYS=7
BACKUP_PATH=./storage/backups

# Web App (Pfad zum statischen Build)
WEB_DIST_PATH=./apps/web/dist
