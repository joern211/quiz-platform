{
  "name": "online-quiz-plattform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @quiz/web --filter @quiz/server dev",
    "build": "pnpm --filter @quiz/web build",
    "start": "pnpm --filter @quiz/server start",
    "db:migrate": "pnpm exec prisma migrate dev --schema=./prisma/schema.prisma",
    "db:generate": "pnpm exec prisma generate --schema=./prisma/schema.prisma",
    "db:push": "pnpm exec prisma db push --schema=./prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "pnpm exec prisma studio --schema=./prisma/schema.prisma",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @quiz/web test:e2e",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "backup": "bash scripts/backup.sh",
    "restore": "bash scripts/restore.sh",
    "import:legacy": "bash scripts/import-legacy.sh",
    "clean": "pnpm -r clean && rm -rf node_modules"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "argon2": "^0.31.2",
    "prisma": "^5.22.0"
  }
}
