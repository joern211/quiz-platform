// Online Quiz Plattform - Prisma Schema
// Database: SQLite for v1, PostgreSQL-ready

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// User / Auth
// ------------------------------------------------------------

model User {
  id           String    @id @default(uuid())
  email        String?   @unique
  displayName  String
  passwordHash String
  role         String    @default("HOST") // ADMIN | HOST (BASIS-STANDARDS: MODERATOR→HOST, Migration 20261010)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  disabledAt   DateTime?

  sessions     Session[]
  rooms        Room[]    @relation("HostRooms")
  auditLogs    AuditLog[]
  permissionGrants RoomPermissionGrant[]
  scoreEvents  ScoreEvent[]

  @@map("users")
}

model Session {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  lastActiveAt DateTime  @default(now())
  revokedAt    DateTime?
  
  createdAt    DateTime  @default(now())
  
  @@index([userId])
  @@map("sessions")
}

// ------------------------------------------------------------
// Game Catalog
// ------------------------------------------------------------

model GameDefinition {
  id                String   @id @default(uuid())
  slug              String   @unique
  name              String
  category          String
  shortDescription  String?
  description       String?
  shortRules        String?
  status            String   @default("PLANNED") // AVAILABLE | BETA | PLANNED | HIDDEN
  minPlayers        Int      @default(2)
  maxPlayers        Int      @default(10)
  estimatedMinutes  Int      @default(15)
  engineVersion     Int      @default(1)
  setupSchemaVersion Int     @default(1)
  hasBuzzer         Boolean  @default(false)
  hasTeams          Boolean  @default(false)
  hasCamera         Boolean  @default(false)
  hasAudio          Boolean  @default(false)
  hasTimer          Boolean  @default(true)
  tags              String   @default("[]") // JSON array
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  setupDrafts       SetupDraft[]
  rooms             Room[]
  
  @@map("game_definitions")
}

// ------------------------------------------------------------
// Content / Questions
// ------------------------------------------------------------

model ContentPool {
  id String @id @default(uuid())
  gameSlug String
  name String
  description String @default("")
  scope String @default("PRIVATE")
  ownerId String?
  editorIdsJson String @default("[]")
  defaultsJson String @default("{}")
  status String @default("ACTIVE")
  revision Int @default(1)
  forkedFromPoolId String?
  legacyPackId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items ContentItem[]
  @@index([gameSlug, scope, ownerId])
  @@map("content_pools")
}

model ContentItem {
  id String @id @default(uuid())
  poolId String
  pool ContentPool @relation(fields: [poolId], references: [id], onDelete: Restrict)
  gameSlug String
  title String @default("")
  payloadJson String
  language String?
  difficulty String?
  tagIdsJson String?
  source String @default("")
  sourceUrl String @default("")
  license String @default("")
  status String @default("DRAFT")
  revision Int @default(1)
  reviewState String @default("NOT_REVIEWED")
  lockState String @default("EDITABLE")
  duplicatedFromId String?
  legacyQuestionId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  revisions ContentRevision[]
  uses ContentUse[]
  mediaReferences ContentMediaReference[]
  @@index([poolId, status])
  @@map("content_items")
}

model ContentRevision {
  id String @id @default(uuid())
  itemId String
  item ContentItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  revision Int
  actorId String?
  kind String
  changedFieldsJson String
  snapshotJson String
  createdAt DateTime @default(now())
  @@unique([itemId, revision])
  @@map("content_revisions")
}

model ContentTag {
  id String @id @default(uuid())
  name String
  slug String @unique
  description String @default("")
  category String @default("")
  aliasesJson String @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("content_tags")
}

model ContentUse {
  id String @id @default(uuid())
  roomId String
  runIndex Int
  itemId String
  item ContentItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  itemRevision Int
  position Int @default(0)
  snapshotJson String
  createdAt DateTime @default(now())
  @@unique([roomId, runIndex, itemId])
  @@map("content_uses")
}

model ContentMutationReceipt {
  id String @id @default(uuid())
  actorId String
  commandId String
  intentHash String
  responseJson String
  createdAt DateTime @default(now())
  @@unique([actorId, commandId])
  @@map("content_mutation_receipts")
}

model ContentImportDraft {
  id String @id @default(uuid())
  poolId String
  actorId String
  rowsJson String
  previewJson String
  targetHash String
  consumedAt DateTime?
  createdAt DateTime @default(now())
  expiresAt DateTime
  @@index([actorId, expiresAt])
  @@map("content_import_drafts")
}

model ContentReview {
  id String @id @default(uuid())
  poolId String
  itemId String?
  actorId String
  baseRevision Int
  kind String
  proposedJson String
  status String @default("IN_REVIEW")
  reviewerId String?
  reason String @default("")
  createdAt DateTime @default(now())
  resolvedAt DateTime?
  @@index([poolId, status])
  @@map("content_reviews")
}

model ContentNotification {
  id String @id @default(uuid())
  userId String
  kind String
  poolId String
  itemId String?
  message String
  readAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, readAt])
  @@map("content_notifications")
}

model ContentComment {
  id String @id @default(uuid())
  itemId String
  actorId String
  message String
  status String @default("OPEN")
  createdAt DateTime @default(now())
  resolvedAt DateTime?
  @@index([itemId, status])
  @@map("content_comments")
}

model QuestionPack {
  id          String   @id @default(uuid())
  gameSlug    String
  title       String
  description String?
  status      String   @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  questions   GeoQuestion[]
  
  @@index([gameSlug])
  @@map("question_packs")
}

model GeoQuestion {
  id           String   @id @default(uuid())
  packId       String
  pack         QuestionPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  title        String?
  prompt       String
  category     String
  mediaAssetId String?
  mediaType    String?  // image | audio
  options      String   // JSON array of {id, text}
  correctOptionId String
  explanation  String?
  durationMs   Int      @default(20000)
  points       Int      @default(100)
  wrongPoints  Int      @default(0)
  enabled      Boolean  @default(true)
  sortOrder    Int      @default(0)
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@index([packId, enabled])
  @@index([mediaAssetId])
  @@map("geo_questions")
}

// ------------------------------------------------------------
// Setup Drafts
// ------------------------------------------------------------

model SetupDraft {
  id              String   @id @default(uuid())
  gameDefinitionId String
  gameDefinition  GameDefinition @relation(fields: [gameDefinitionId], references: [id])
  ownerId         String?
  configJson      String   // JSON
  contentJson     String   // JSON
  schemaVersion   Int      @default(1)
  isValid         Boolean  @default(false)
  validationErrors String? // JSON array of errors
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([gameDefinitionId])
  @@map("setup_drafts")
}

// ------------------------------------------------------------
// Rooms
// ------------------------------------------------------------

model Room {
  setupBlueprintsJson String?
  contentVisibility String @default("HOST_PREVIEW")
  id                 String   @id @default(uuid())
  code               String   @unique
  roomName           String
  gameDefinitionId   String
  gameDefinition     GameDefinition @relation(fields: [gameDefinitionId], references: [id])
  hostUserId         String
  host               User     @relation("HostRooms", fields: [hostUserId], references: [id])
  
  status             String   @default("CREATED") // CREATED | LOBBY | RUNNING | ENDED | ARCHIVED
  runPhase           String   @default("DRAFT")
  
  pinHash            String?
  isPublic           Boolean  @default(true)
  maxPlayers         Int      @default(10)
  cameraEnabled      Boolean  @default(false)
  allowViewers       Boolean  @default(true)
  viewerRequiresPin  Boolean  @default(true)
  viewerLimit        Int      @default(50)
  lobbyChatEnabled   Boolean  @default(true)
  
  setupSnapshotJson  String   @default("{}")
  setupSchemaVersion Int      @default(1)

  // BASIS-STANDARDS (E): Konfigurations-Schema-Version + endgültiger, unveränderlicher
  // Start-Snapshot (GameConfigSnapshot als JSON: values mit Herkunft, engineVersion).
  // Bestandsräume ohne Snapshot tragen configSchemaVersion=0 und werden IMMER über
  // die Legacy-Strategie (setupSnapshotJson + Manifest-Defaults) gelesen — nie still
  // aus heutigen Defaults neu interpretiert.
  configSchemaVersion    Int      @default(0)
  gameConfigSnapshotJson String?

  // BASIS-STANDARDS (E3/E4): effektive LIVE-Überschreibungen (Resolved-Werte,
  // Quelle LIVE_OVERRIDE). MUTABEL — auch nach Start (nur EDITABLE-Felder);
  // gameConfigSnapshotJson (Start-Snapshot) bleibt dabei unverändert.
  liveConfigJson         String?

  // Audit 11-06 (P1): serverseitige Idempotenz für Raum-Erstellungs-Requests.
  // Ein Client (Doppelklick/Timeout-Retry) sendet dasselbe Idempotency-Token;
  // der erste Request legt den Raum an, identische Wiederholungen erhalten die
  // EXISTIERENDEN Raum-Daten statt einen zweiten Raum zu erzeugen. Eine neue,
  // bewusste Raumerstellung verwendet ein neues Token → bleibt möglich.
  // NULL (kein Token) → keine Idempotenz (Legacy/andere Clients), NULL ≠ NULL.
  idempotencyKey   String?
  createdByUserId  String?
  
  roomPolicyJson     String?
  lifecycle          String?
  scheduledAt        DateTime?
  expiresAt          DateTime?
  runIndex           Int      @default(1)
  teams              RoomTeam[]
  teamHistory        TeamMembership[]
  feed               RoomFeedEntry[]
  runs               RoomRun[]
  invites            RoomInvite[]
  revision           Int      @default(0)
  
  createdAt          DateTime @default(now())
  startedAt          DateTime?
  endedAt            DateTime?
  archivedAt         DateTime?
  eventSeriesId      String?
  
  participations     Participation[]
  permissionGrants   RoomPermissionGrant[]
  commandReceipts    CommandReceipt[]
  gameEvents         GameDomainEvent[]
  gameResults        GameResultRecord[]
  roundResults       RoundResultRecord[]
  displaySessions DisplaySession[]
  mediaControl RoomMediaControl?
  mediaParticipantControls ParticipantMediaControl[]
  viewerSessions     ViewerSession[]
  chatMessages       ChatMessage[]
  scoreEvents        ScoreEvent[]
  gameState          RoomGameState?
  
  @@index([code])
  @@index([status])
  @@index([hostUserId])
  // Audit 11-06: ein Idempotency-Token gehört zu genau einem Raum des Hosts
  // (Wiederholung → gleicher Raum). NULL (kein Token) ist in SQLite distinct.
  @@unique([idempotencyKey, createdByUserId])
  @@map("rooms")
}

// Server-only immutable transition records; never a public snapshot endpoint.
model GameDomainEvent {
  id String @id
  roomId String
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  runIndex Int
  gameSlug String
  engineVersion Int
  baseStateVersion Int
  stateVersion Int
  type String
  commandId String?
  actorId String?
  payloadJson String
  occurredAt DateTime
  @@unique([roomId, runIndex, stateVersion])
  @@index([roomId, runIndex, commandId])
  @@map("game_domain_events")
}

// ------------------------------------------------------------
// Participations
// ------------------------------------------------------------

model Participation {
  id                   String   @id @default(uuid())
  roomId               String
  room                 Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  
  displayName          String
  normalizedName       String
  role                 String   // HOST | PLAYER | VIEWER | DISPLAY (BASIS-STANDARDS)
  
  avatarMode           String   @default("none") // none | avatar | camera
  avatarAssetId        String?
  avatarGenerated      String?  // JSON {initials, color, icon}
  
  connected            Boolean  @default(false)
  // Socket owning presence; delayed disconnects may only release this owner.
  connectionId         String?
  lastRoundTripMs      Int?
  ready                Boolean  @default(false)
  kickedAt             DateTime?
  lastSeenAt           DateTime @default(now())
  
  score                Int      @default(0)
  lives                Int?
  
  teamId               String?
  userId               String?
  hasSeenHostSecrets   Boolean  @default(false)
  guestKeyHash         String?
  admission            String   @default("ACTIVE")
  bannedAt             DateTime?
  leftAt               DateTime?
  activeNameKey        String?
  nameHistoryJson      String   @default("[]")
  
  rejoinToken          String   @unique
  rejoinTokenVersion   Int      @default(1)
  
  createdAt            DateTime @default(now())
  
  scoreEvents          ScoreEvent[]
  chatMessages         ChatMessage[]

  @@index([roomId])
  @@unique([roomId, activeNameKey])
  @@index([rejoinToken])
  @@map("participations")
}

model ViewerSession {
  id            String    @id @default(uuid())
  roomId        String
  room          Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  connected     Boolean   @default(false)
  lastSeenAt    DateTime  @default(now())
  disconnectedAt DateTime?
  
  createdAt     DateTime  @default(now())
  
  @@index([roomId])
  @@index([roomId, connected])
  @@map("viewer_sessions")
}

// ------------------------------------------------------------
// Game State
// ------------------------------------------------------------

model RoomGameState {
  id            String   @id @default(uuid())
  roomId        String   @unique
  room          Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  engineVersion Int      @default(1)
  phase         String   @default("INTRO")
  stateJson     String   @default("{}")
  revision      Int      @default(0)
  updatedAt     DateTime @updatedAt
  
  @@map("room_game_states")
}

// ------------------------------------------------------------
// Chat
// ------------------------------------------------------------

model ChatMessage {
  id         String   @id @default(uuid())
  roomId     String
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId   String?
  sender     Participation? @relation(fields: [senderId], references: [id])
  senderName String
  content    String
  createdAt  DateTime @default(now())
  
  @@index([roomId])
  @@map("chat_messages")
}

// ------------------------------------------------------------
// Score Events
// ------------------------------------------------------------

model ScoreEvent {
  id             String   @id @default(uuid())
  roomId         String
  room           Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  participationId String
  participation  Participation @relation(fields: [participationId], references: [id])
  teamId         String?
  runIndex       Int      @default(1)
  roundIndex     Int      @default(0)
  delta          Int
  reason         String
  source         String   @default("auto") // auto | manual
  roundKey       String?
  kind           String   @default("GAME_SCORE")
  referenceEventId String?
  moderatorId    String?
  moderator      User?    @relation(fields: [moderatorId], references: [id])
  createdAt      DateTime @default(now())
  
  @@index([roomId])
  @@index([participationId])
  @@map("score_events")
}

// Compact historical results. Engine state remains GAME_END for old clients.
// Lifecycle and the current revision are separate from immutable result versions.
model GameResultRecord {
  id String @id @default(uuid())
  roomId String
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  runIndex Int
  gameSlug String
  engineVersion Int
  status String @default("GAME_END")
  revision Int @default(1)
  configSnapshotJson String?
  endedAt DateTime
  finalizedAt DateTime?
  versions GameResultVersion[]
  @@unique([roomId, runIndex])
  @@map("game_results")
}
model GameResultVersion {
  id String @id @default(uuid())
  resultId String
  result GameResultRecord @relation(fields: [resultId], references: [id], onDelete: Cascade)
  revision Int
  kind String
  actorId String?
  reason String?
  dataJson String
  createdAt DateTime @default(now())
  @@unique([resultId, revision])
  @@map("game_result_versions")
}
model RoundResultRecord {
  id String @id @default(uuid())
  roomId String
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  runIndex Int
  roundKey String
  stateVersion Int
  dataJson String
  createdAt DateTime @default(now())
  @@unique([roomId, runIndex, roundKey])
  @@map("round_results")
}

// ------------------------------------------------------------
// Media
// ------------------------------------------------------------

model MediaAsset {
  id              String   @id @default(uuid())
  type            String   // image | audio | video
  mimeType        String
  filename        String
  originalName    String
  fileSize        Int
  width           Int?
  height          Int?
  duration        Int?     // for audio/video in ms
  // PR11-Nacharbeit B: Content-Identität ist je Uploader eindeutig (additive
  // Migration, ersetzt das globale @unique auf sha256). Gleicher Content +
  // gleicher Uploader → Dedupe; gleicher Content + ANDERER Uploader → eigenes
  // Asset (kein 500, kein Ownership-Leak, keine gemeinsame Datei).
  // Legacy-Zeilen mit uploadedBy NULL bleiben lesbar (SQLite: NULL ≠ NULL).
  sha256          String
  // Audit 11-03/11-04 (P1): LOGISCHE Identität, getrennt von den physischen
  // Bytes. sha256 ist nur der Content-Hash (Integrität); die Dedupe-Identität
  // ist `assetKey`:
  //   - Upload:   assetKey = Content-Hash (gleiche Bytes + gleicher Owner → Dedupe),
  //                der ZUGRIFFSKONTEXT (visibility) ist Teil des Unique-Keys →
  //                ein neuer PRIVATE-Upload erbt NICHT den Kontext einer PUBLIC-Zeile (11-04).
  //   - Composite: assetKey = "fusion:<ordnungs-sensitive Quellen-Identität>" →
  //                verschiedene Quellpaare behalten eigene Provenienz, selbst wenn
  //                die Ausgabe-Bytes identisch sind (11-03); vertauschte Quellen
  //                (A/B vs B/A) sind verschiedene Assets (11-02).
  // Legacy-Zeilen (vor dieser Spalte) tragen NULL → im Unique-Index distinct.
  assetKey        String?
  storagePath     String
  uploadedBy      String?
  // PRIVATE | SHARED | PUBLIC | SYSTEM | ROOM_TEMP (Regelwerk §7.3)
  // Legacy-Zeilen dürfen weiterhin 'PRIVATE' | 'PUBLIC' | 'ROOM' tragen.
  visibility      String   @default("PRIVATE")
  roomId          String?
  processed       Boolean  @default(false)
  thumbnailPath   String?
  // PR11 (§7.5): IDs der Quell-Assets, aus denen dieses Asset abgeleitet wurde
  // (z.B. Fusion/Composite aus mehreren Bildern). JSON-Array, z.B. ["a","b"].
  // null = Original/Quelle, keine abgeleitete Ableitung.
  derivedFromAssetIds String?
  // PR11 (§7.7): Verarbeitungsstatus. Bestehende Assets bleiben "READY".
  // READY | PROCESSING | FAILED | REJECTED — Normalspiele akzeptieren nur READY.
  processStatus       String   @default("READY")

  createdAt       DateTime @default(now())

  // PR11-Nacharbeit B + Audit 11-03/11-04: Dedupe über die LOGISCHE Identität
  // `assetKey` (nicht über die rohen Bytes), getrennt pro Uploader UND pro
  // Zugriffskontext (visibility). Damit:
  //   - gleicher Owner + gleicher Content + gleicher Kontext → Dedupe (P2002-Race
  //     bei parallelen identischen Uploads wird kontrolliert aufgelöst);
  //   - gleicher Content + anderer Kontext (z.B. PUBLIC vs PRIVATE) → EIGENE
  //     Zeile (ein frischer PRIVATE-Upload erbt den Kontext einer PUBLIC-Zeile
  //     NICHT, 11-04);
  //   - Composite: assetKey ist ordnungs-sensitive Quellen-Identität → andere
  //     Quellpaare behalten eigene Provenienz, selbst bei identischen Bytes (11-03).
  // Legacy-Zeilen (assetKey NULL) sind in SQLite vom Unique-Index ausgenommen
  // und bleiben unverändert lesbar.
  @@unique([assetKey, uploadedBy, visibility])
  @@index([sha256])
  @@index([assetKey])

  processingSources MediaProcessingJob[]
  variantOriginals MediaAssetVariant[] @relation("VariantOriginal")
  variantOutputs MediaAssetVariant[] @relation("VariantOutput")
  variantKind String @default("WEB")
  contentReferences ContentMediaReference[]

  // Note: GeoQuestion holds the forward relation via mediaAssetId

  @@map("media_assets")
}

// ------------------------------------------------------------
// Audit Log
// ------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  resource   String?
  resourceId String?
  metadata   String?  // JSON
  ipAddress  String?
  createdAt  DateTime @default(now())
  
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ------------------------------------------------------------
// Event Series (Quizabend, Turnier)
// ------------------------------------------------------------

model EventSeries {
  id          String   @id @default(uuid())
  title       String
  description String?
  eventType   String   @default("QUIZ_NIGHT") // QUIZ_NIGHT | TOURNAMENT | LEAGUE
  status      String   @default("PLANNING") // PLANNING | ACTIVE | ENDED
  settings    String   @default("{}") // JSON
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("event_series")
}

// ============================================================
// BASIS-STANDARDS (B): Berechtigungs-Delegation (Grants/Revocation)
// ------------------------------------------------------------
// Pro Raum + eingeloggter Nutzer: wirksame Rechte = Rollen-Default ±
// Grants/Revocations (separat je Recht, je Richtung). Co-Host bleibt
// default OFF: ohne explizite Grant-Zeile hat ein zweiter eingeloggter
// Nutzer genau die Rechte seiner Rolle (HOST-Paket nur für den
// Raum-Host selbst — hier nur die Delegationsgrundlage, keine
// neuen Secrets). Display/Viewer sind nie Adressaten dieser Zeilen.
// ============================================================
model RoomPermissionGrant {
  roomId        String
  room          Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission    String     // exakt ein GamePermission-Wert
  direction     String     // GRANT | REVOKE
  grantedBy     String
  createdAt     DateTime   @default(now())
  revokedAt     DateTime?

  @@id([roomId, userId, permission, direction])
  @@index([roomId])
  @@index([userId])
  @@map("room_permission_grants")
}

// ============================================================
// BASIS-STANDARDS (C): Command-Receipts (Wiederholungssicherheit)
// ------------------------------------------------------------
// Ein Receipt pro (Room, commandId). Atomarer Claim über die Unique-Key:
// parallel ankommende Duplikate erhalten createUnique→UNIQUE und lesen
// das bestehende Receipt statt eine zweite Wirkung auszulösen.
// status: PENDING (claimed; Engine-Schreibtransaktionen prüfen Besitzer) →
// COMPLETED (Response gespeichert) / REJECTED (kontrollierte Ablehnung,
// z.B. COMMAND_CONFLICT bei anderer Payload/Akteur) / FAILED (Mutation
// fehlgeschlagen/Rollback → kein Erfolgseintrag; Retry erlaubt).
// Gleiche commandId mit anderer actorId/payloadHash → COMMAND_CONFLICT
// (keine fremden Ergebnisse, keine zusätzlichen Rechte).
// Retention: Receipts einer aktiven Sitzung werden NICHT gelöscht;
// Cleanup gehört zu einem späteren, benannten GC-Auftrag.
// ============================================================
model CommandReceipt {
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  commandId   String
  actorId     String   // Participation-ID oder Session-ID des Akteurs (serverseitig aufgelöst)
  actorRole   String   // wirksame Rolle zum Zeitpunkt der Verarbeitung
  action      String   // z.B. ANSWER_SUBMIT, BUZZ, JUDGE, REVEAL, START, PAUSE, ABORT
  payloadHash String   // SHA-256 über (action + normalized payload)
  stateVersion Int?    // Versionserwartung (expectedRevision) zum Zeitpunkt des Claims
  // Beobachtungen vor dem Claim, keine gemeinsame Read-/Engine-Transaktion.
  // Recovery prüft beide erneut und sichert sie beim ersten Engine-Write ab.
  beforeRevision Int?
  beforeStateRevision Int?
  // Abgelaufene Lease erlaubt nur einen exklusiven Takeover ohne bereits
  // committierten Effekt. Sie allein erklärt einen lebenden Handler nicht tot.
  leaseExpiresAt DateTime?
  // Each claim/takeover has a new owner. Engine writes check it in their TX.
  executionToken String?
  // Committed with the first engine write. Applied intents never re-execute.
  mutationStartedAt DateTime?
  status      String   // PENDING | COMPLETED | REJECTED | FAILED
  responseJson String? // persistierte Erfolgs-/Ablehnungsantwort (Duplicate liefert gespeicherte Antwort)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@id([roomId, commandId])
  @@index([roomId])
  @@map("command_receipts")
}

// TEAM-ROOM: historical rows survive leave, reshuffle and new game runs.
model RoomTeam {
  id String @id @default(uuid())
  roomId String
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  name String
  color String
  icon String
  score Int @default(0)
  createdAt DateTime @default(now())
  @@index([roomId])
  @@map("room_teams")
}
model TeamMembership {
  id String @id @default(uuid())
  roomId String
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  participationId String
  teamId String?
  runIndex Int
  startedAt DateTime @default(now())
  endedAt DateTime?
  @@index([roomId, participationId])
  @@map("team_memberships")
}
model RoomFeedEntry {
  id String @id @default(uuid())
  roomId String
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  kind String
  message String
  actorId String?
  createdAt DateTime @default(now())
  @@index([roomId, createdAt])
  @@map("room_feed_entries")
}
model RoomRun {
  id String @id @default(uuid())
  roomId String
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  runIndex Int
  gameDefinitionId String
  engineVersion Int?
  configSnapshotJson String?
  stateJson String?
  scoresJson String
  teamsJson String
  endedAt DateTime @default(now())
  @@unique([roomId, runIndex])
  @@map("room_runs")
}
model RoomInvite {
  id String @id @default(uuid())
  roomId String
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  role String
  expiresAt DateTime
  usedAt DateTime?
  @@index([roomId])
  @@map("room_invites")
}

// Ephemeral editor presence. A lost tab expires; this is not a write lock.
model ContentEditorPresence {
  id String @id @default(uuid())
  itemId String
  sessionId String
  editorKey String
  userId String
  lastSeenAt DateTime @default(now())
  @@unique([itemId, sessionId, editorKey])
  @@index([itemId, lastSeenAt])
  @@map("content_editor_presence")
}

model ContentMediaReference {
  id String @id @default(uuid())
  itemId String
  item ContentItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  itemRevision Int
  assetId String
  asset MediaAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  authorizedBy String?
  createdAt DateTime @default(now())
  @@unique([itemId, itemRevision, assetId])
  @@index([assetId])
  @@map("content_media_references")
}

model ContentTemplate {
  id String @id @default(uuid())
  ownerId String
  gameSlug String
  name String
  itemJson String
  revision Int @default(1)
  status String @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([ownerId, gameSlug, status])
  @@map("content_templates")
}

model ContentReviewAssignment {
  id String @id @default(uuid())
  itemId String
  poolId String
  assigneeId String
  assignedBy String
  itemRevision Int
  revision Int @default(1)
  status String @default("OPEN")
  note String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  completedAt DateTime?
  @@unique([itemId, assigneeId])
  @@index([assigneeId, status])
  @@map("content_review_assignments")
}

model ContentPlaytest {
  id           String                    @id @default(uuid())
  code         String                    @unique
  ownerId      String
  poolId       String
  gameSlug     String
  snapshotJson String
  position     Int                       @default(0)
  version      Int                       @default(1)
  phase        String                    @default("QUESTION")
  startedAt    DateTime                  @default(now())
  expiresAt    DateTime
  createdAt    DateTime                  @default(now())
  feedback     ContentPlaytestFeedback[]

  @@index([ownerId, expiresAt])
  @@map("content_playtests")
}

model ContentPlaytestFeedback {
  id         String          @id @default(uuid())
  playtestId String
  playtest   ContentPlaytest @relation(fields: [playtestId], references: [id], onDelete: Cascade)
  position   Int
  clientKey  String
  kind       String
  value      String
  createdAt  DateTime        @default(now())

  @@unique([playtestId, position, clientKey, kind])
  @@map("content_playtest_feedback")
}

model ContentDifficultyPreset {
  id       String @id @default(uuid())
  ownerId  String
  gameSlug String
  name     String
  planJson String
  revision Int @default(1)
  status   String @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, gameSlug, status])
  @@map("content_difficulty_presets")
}

model SetupBlueprint {
  id String @id @default(uuid())
  ownerId String
  kind String
  gameSlug String?
  name String
  configurationJson String
  favorite Boolean @default(false)
  revision Int @default(1)
  status String @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, kind, status])
  @@map("setup_blueprints")
}

model RoomMediaControl {
  roomId String @id
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  revision Int @default(1)
  policyJson String @default("{}")
  @@map("room_media_controls")
}
model ParticipantMediaControl {
  id String @id @default(uuid())
  roomId String
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  participantId String
  hostMuted Boolean @default(false)
  cameraHidden Boolean @default(false)
  @@unique([roomId, participantId])
  @@map("participant_media_controls")
}

model DisplaySession {
  id String @id @default(uuid())
  roomId String
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  connected Boolean @default(true)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([roomId])
  @@map("display_sessions")
}

model MediaProcessingJob {
  id String @id @default(uuid())
  ownerId String
  commandId String
  inputHash String
  originalId String
  original MediaAsset @relation(fields: [originalId], references: [id], onDelete: Restrict)
  outputId String?
  status String @default("QUEUED")
  attempts Int @default(0)
  leaseToken String?
  leaseUntil DateTime?
  errorCode String?
  retryable Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([ownerId, commandId])
  @@index([status, leaseUntil])
  @@map("media_processing_jobs")
}
model MediaAssetVariant {
  id String @id @default(uuid())
  originalId String
  original MediaAsset @relation("VariantOriginal", fields: [originalId], references: [id], onDelete: Restrict)
  assetId String
  asset MediaAsset @relation("VariantOutput", fields: [assetId], references: [id], onDelete: Restrict)
  kind String
  @@unique([originalId, kind])
  @@map("media_asset_variants")
}
